# --- Ajouts au .env pour le RAG ---
# Fins de ligne LF obligatoires.

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rag_admin
# 8 caractères minimum, exigé par MinIO
MINIO_SECRET_KEY=
MINIO_SECURE=false

# Nom de bucket au format S3 : minuscules, chiffres, tirets
RAG_BUCKET=rag-souverain
RAG_TAILLE_CHUNK=1000
RAG_CHEVAUCHEMENT=150
RAG_MODELE_EMBEDDING=nomic-embed-text
RAG_DIMENSION=768
